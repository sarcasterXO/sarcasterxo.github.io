{
	"name": "personal-website",
	"private": true,
	"description": "Personal website of Aarya Chavan, aka Sarcaster.",
	"homepage": "https://sarcaster.is-a.dev",
	"license": "Apache-2.0",
	"author": "Aarya Chavan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sarcasterXO/sarcasterxo.github.io.git"
	},
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"lint": "oxlint --fix .",
		"lint:check": "oxlint .",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
		"preflight": "bun format && bun typecheck && bun run lint && bun run build",
		"prepare": "husky .github/husky"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.1",
		"motion": "14.9.0",
		"next": "16.4.3",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-icons": "5.7.0",
		"shadcn": "^4.23.0",
		"three": "0.187.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@imranbarbhuiya/oxc-config": "0.4.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.187.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"postcss": "8.5.32",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern",
		"*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}": "oxlint --fix"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"packageManager": "bun@1.4.4"
}
